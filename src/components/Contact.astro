---
import ContactForm from "./ContactForm";
---

<section id="contact" class="w-full py-14 md:py-20 lg:py-24">
  <div
    class="flex flex-col items-center justify-center text-center px-4 mb-10 md:mb-14"
  >
    <h2
      class="text-3xl lg:text-[40px] font-bold mb-4 flex flex-col sm:flex-row gap-2 justify-center text-txt-primary"
    >
      Hablemos de tu <span class="gradient-blue">proyecto</span>
    </h2>
    <p class="text-lg text-txt-secondary max-w-2xl">
      Te ayudamos a llevar tu negocio al siguiente nivel.
    </p>
  </div>
  <div
    class="container mx-auto px-4 flex flex-col lg:flex-row justify-center lg:gap-12 xl:gap-20 items-start lg:items-center"
  >
    <div class="w-full lg:w-auto mb-10 lg:mb-0">
      <h3
        class="text-xl md:text-2xl lg:text-[28px] font-semibold leading-snug mb-8 text-txt-primary"
      >
        Conectá con nosotros
      </h3>

      <div class="flex flex-col gap-4 max-w-md mx-auto lg:mx-0">
        <a
          href="mailto:emprendev2.0@gmail.com"
          class="glass-card p-4 sm:p-5 flex items-center gap-3 sm:gap-4 rounded-card hover:shadow-card-hover transition-shadow"
        >
          <span
            class="icon-[entypo--email] w-9 h-9 sm:w-10 sm:h-10 p-2 bg-accent-subtle text-accent dark:text-accent-hover rounded-xl flex-shrink-0"
            role="img"
            aria-hidden="true"></span>
          <span class="flex flex-col min-w-0">
            <span class="text-sm text-txt-muted">Email:</span>
            <span class="text-sm sm:text-base text-txt-primary break-all">
              emprendev2.0@gmail.com
            </span>
          </span>
        </a>

        <a
          href="https://wa.me/1126922128"
          class="glass-card p-4 sm:p-5 flex items-center gap-3 sm:gap-4 rounded-card hover:shadow-card-hover transition-shadow"
        >
          <span
            class="icon-[logos--whatsapp-icon] w-9 h-9 sm:w-10 sm:h-10 p-2 rounded-xl flex-shrink-0"
            role="img"
            aria-hidden="true"></span>
          <span class="flex flex-col min-w-0">
            <span class="text-sm text-txt-muted">WhatsApp:</span>
            <span class="text-sm sm:text-base text-txt-primary">
              1126922128
            </span>
          </span>
        </a>
      </div>
    </div>

    <div class="w-full lg:w-auto">
      <ContactForm client:load />
    </div>
  </div>
</section>
