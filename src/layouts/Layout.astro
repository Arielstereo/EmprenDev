---
const { title } = Astro.props;
import "@fontsource-variable/orbitron";
import "@fontsource/kanit";
import "@fontsource/paytone-one";
import "@fontsource-variable/rubik";
import Navbar from "@components/Navbar";
import NavbarMobile from "@components/NavbarMobile";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="google-site-verification"
      content="qGCnmT790OHmqDOzts3TDjYJ0jSRQRscQHJHb_hSeIM"
    />
    <meta
      name="description"
      content="Desarrollo y diseño de páginas web profesionales para emprendedores, pymes y pequeños negocios. Aumenta tu presencia online y atrae más clientes con un sitio web moderno y personalizado."
    />
    <meta
      name="keywords"
      content="desarrollo web, diseño web, páginas web, emprendedores, pymes, pequeños negocios, sitios web, presencia online"
    />
    <meta name="author" content="EmprenDev" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/logo.png" />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark =
            stored === "dark" ||
            (!stored &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>

    <script
      is:inline
      src="https://cdn.botpress.cloud/webchat/v3.2/inject.js"
      defer></script>
    <script
      is:inline
      src="https://files.bpcontent.cloud/2025/07/28/23/20250728230027-KPGIXL9V.js"
      defer></script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js");
        });
      }
    </script>
  </head>
  <body>
    <div class="hidden md:block">
      <Navbar client:load />
    </div>
    <div class="block md:hidden">
      <NavbarMobile client:load />
    </div>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    /* Surfaces — light mode: airy with soft shadows */
    --surface-base: #f5f7fb;
    --surface-1: #ffffff;
    --surface-2: #ffffff;
    --surface-3: #ffffff;

    /* Borders — whisper-quiet, blend with bg */
    --border-subtle: rgba(15, 23, 42, 0.06);
    --border-default: rgba(15, 23, 42, 0.1);
    --border-emphasis: rgba(15, 23, 42, 0.16);
    --border-accent: rgba(59, 130, 246, 0.35);

    /* Text hierarchy — four levels */
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --text-muted: #94a3b8;

    /* Accent */
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --accent-dark: #1e3a8a;
    --accent-subtle: rgba(59, 130, 246, 0.16);

    --shadow-card: 0 1px 2px rgba(15, 23, 42, 0.04),
      0 4px 16px -2px rgba(15, 23, 42, 0.06);
    --shadow-card-hover: 0 2px 4px rgba(15, 23, 42, 0.05),
      0 12px 28px -4px rgba(15, 23, 42, 0.12);
  }

  .dark {
    /* Surfaces — dark mode: warm slate, shift only lightness, one hue */
    --surface-base: #0b1220;
    --surface-1: #111a2c;
    --surface-2: #16213a;
    --surface-3: #1c2947;

    /* Borders — low-opacity white, progress by importance */
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-default: rgba(255, 255, 255, 0.1);
    --border-emphasis: rgba(255, 255, 255, 0.16);
    --border-accent: rgba(96, 165, 250, 0.3);

    /* Text — inverted hierarchy */
    --text-primary: #f1f5f9;
    --text-secondary: #cbd5e1;
    --text-muted: #64748b;

    /* Accent — lifted for dark contrast */
    --accent: #3b82f6;
    --accent-hover: #60a5fa;
    --accent-dark: #1d4ed8;
    --accent-subtle: rgba(59, 130, 246, 0.18);

    --shadow-card: 0 0 0 1px rgba(255, 255, 255, 0.06);
    --shadow-card-hover: 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 12px 32px -8px rgba(0, 0, 0, 0.4);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    background-color: var(--surface-base);
    color: var(--text-primary);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  a,
  span,
  button {
    font-family: "Orbitron Variable", sans-serif;
  }
  p,
  label,
  input,
  textarea {
    font-family: "Kanit", sans-serif;
  }
  h1,
  h2 {
    font-family: "Paytone One", sans-serif;
    letter-spacing: -0.01em;
  }
  h3 {
    font-family: "Rubik Variable", sans-serif;
    letter-spacing: -0.01em;
  }

  .glass {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border-subtle);
  }
  .dark .glass {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-card);
  }
  .dark .glass-card {
    background: var(--surface-1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  .gradient-blue {
    background: linear-gradient(
      135deg,
      var(--accent),
      hsl(210 86% 56%)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .dark .gradient-blue {
    background: linear-gradient(
      135deg,
      var(--accent-hover),
      hsl(210 90% 68%)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
